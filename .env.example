# Naturalitos Acuario - Backend Config Template
# Copia este archivo como .env y ajusta los valores

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=naturalitos_movil_db
DB_USER=root
DB_PASS=

# JWT
JWT_SECRET=CHANGE_THIS_SECRET_KEY
JWT_ALGORITHM=HS256
JWT_EXPIRATION=86400

# App
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/naturalitosAndroid/backend/public
